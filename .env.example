# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- Auth and CORS ---
DEMO_PASSCODE=change-me
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# dev = gpt-5.6-terra planner; demo = gpt-5.6-sol planner (recording and final evidence only)
LLM_PROFILE=dev
# record | replay | off. Tests always force replay.
LLM_REPLAY=record
# Hard local cap in USD; the adapter switches to Gemini once it is hit.
LLM_BUDGET_USD=7
# Per-call timeout; a timeout falls back to Gemini.
LLM_TIMEOUT_S=60
GEMINI_MODEL=gemini-2.5-flash

# --- On-chain anchoring (testnet only: 11155111 Sepolia, 84532 Base Sepolia) ---
ANCHOR_RPC_URL=https://sepolia.rpc.placeholder.invalid
# Throwaway faucet-funded testnet key. Placeholder below is intentionally not a valid key.
ANCHOR_PRIVATE_KEY=0xREPLACE_WITH_THROWAWAY_TESTNET_KEY
ANCHOR_CHAIN_ID=11155111
ANCHOR_BATCH_SIZE=20
ANCHOR_EXPLORER_URL=https://sepolia.etherscan.io
# Record/replay for the anchoring RPC (defaults to LLM_REPLAY). replay never sends; set record (or off) on the demo
# server so "Anchor now" and the automatic batches reach the testnet. `make anchor` always records.
# ANCHOR_REPLAY=record

# --- Skill library (scripts/sign_skill.py; only needed to re-sign the built-in skills) ---
# Ed25519 seed (hex) whose public key is LIBRARY_PUBLIC_KEY in backend/app/packs/library_key.py.
# SKILL_LIBRARY_SIGNING_KEY=

# --- Gmail (real inbox via OAuth; the sandbox mailbox stays as the fallback) ---
# OAuth web client from Google Cloud (Gmail API enabled, consent screen in testing mode, demo account as test user).
GMAIL_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GMAIL_REDIRECT_URI=http://localhost:8000/inbox/gmail/callback
# Encrypts each business's Gmail refresh token at rest. 64 hex chars:
#   python -c "import secrets; print(secrets.token_hex(32))"
GMAIL_TOKEN_KEY=
# Comma-separated addresses that approved emails may really be sent to. Anything else goes to the simulated outbox,
# labelled, so rehearsals never email a real customer.
DEMO_SEND_ALLOWLIST=
# Seconds between checks of a connected inbox (min 2).
# GMAIL_POLL_SECONDS=7
