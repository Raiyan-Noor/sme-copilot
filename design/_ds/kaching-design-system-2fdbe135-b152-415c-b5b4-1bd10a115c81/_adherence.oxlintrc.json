{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/alert-banner/**",
              "components/approval-card/**",
              "components/badge/**",
              "components/button/**",
              "components/card/**",
              "components/chat-bubble/**",
              "components/fact-number/**",
              "components/icon/**",
              "components/kpi-tile/**",
              "components/progress/**",
              "components/sheet/**",
              "components/table/**",
              "components/tabs/**",
              "components/tier-row/**",
              "components/toast/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Public Sans))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Public Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|eyebrow|title|children|actions|onDismiss|className|key|ref|className|style|children)$/]",
        "message": "<AlertBanner> doesn't accept that prop. Declared props: variant, eyebrow, title, children, actions, onDismiss, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fraud|info)$/]",
        "message": "<AlertBanner> variant must be one of 'fraud' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|amount|onAmountClick|description|facts|limitNote|status|meta|resolvedNote|approveLabel|declineLabel|onApprove|onDecline|className|key|ref|className|style|children)$/]",
        "message": "<ApprovalCard> doesn't accept that prop. Declared props: title, amount, onAmountClick, description, facts, limitNote, status, meta, resolvedNote, approveLabel, declineLabel, onApprove, onDecline, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:waiting|executed|blocked)$/]",
        "message": "<ApprovalCard> status must be one of 'waiting' | 'executed' | 'blocked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, icon, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|brand|savings|outline)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'brand' | 'savings' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|loading|disabled|fullWidth|type|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, loading, disabled, fullWidth, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|eyebrow|title|description|action|footer|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, eyebrow, title, description, action, footer, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|muted|improve)$/]",
        "message": "<Card> variant must be one of 'default' | 'muted' | 'improve'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|children|meta|name|avatarSrc|attachment|className|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: role, children, meta, name, avatarSrc, attachment, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:owner|copilot)$/]",
        "message": "<ChatBubble> role must be one of 'owner' | 'copilot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|source|tone|key|ref|className|style|children)$/]",
        "message": "<FactNumber> doesn't accept that prop. Declared props: children, onClick, source, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactNumber'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|positive|negative)$/]",
        "message": "<FactNumber> tone must be one of 'default' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactorBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|valueLabel|hint|tone|threshold|thresholdLabel|className|key|ref|className|style|children)$/]",
        "message": "<FactorBar> doesn't accept that prop. Declared props: label, value, max, valueLabel, hint, tone, threshold, thresholdLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactorBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|teal|gold|danger|neutral)$/]",
        "message": "<FactorBar> tone must be one of 'brand' | 'teal' | 'gold' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|caption|icon|size|onTrace|source|className|key|ref|className|style|children)$/]",
        "message": "<KpiTile> doesn't accept that prop. Declared props: label, value, delta, caption, icon, size, onTrace, source, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<KpiTile> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|tone|size|label|className|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, max, tone, size, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|teal|gold|danger|neutral)$/]",
        "message": "<Progress> tone must be one of 'brand' | 'teal' | 'gold' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Progress> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onOpenChange|title|description|children|footer|side|width|contained|className|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onOpenChange, title, description, children, footer, side, width, contained, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<Sheet> side must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|size|className|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, label, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:executed|waiting|blocked|fits|doesnt-fit|synthetic)$/]",
        "message": "<StatusPill> status must be one of 'executed' | 'waiting' | 'blocked' | 'fits' | 'doesnt-fit' | 'synthetic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatusPill> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|align|width|render|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, header, align, width, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|defaultValue|onValueChange|size|className|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, defaultValue, onValueChange, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tabs> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|name|description|mode|limit|tools|signedNote|onEdit|editLabel|className|key|ref|className|style|children)$/]",
        "message": "<TierRow> doesn't accept that prop. Declared props: tier, name, description, mode, limit, tools, signedNote, onEdit, editLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierRow'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:auto|approval|never)$/]",
        "message": "<TierRow> mode must be one of 'auto' | 'approval' | 'never'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|description|action|onClose|icon|className|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: variant, title, description, action, onClose, icon, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|success|danger|savings)$/]",
        "message": "<Toast> variant must be one of 'default' | 'success' | 'danger' | 'savings'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TraceStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|source|op|emphasis|key|ref|className|style|children)$/]",
        "message": "<TraceStep> doesn't accept that prop. Declared props: label, value, source, op, emphasis."
      }
    ]
